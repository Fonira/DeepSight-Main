# ═══════════════════════════════════════════════════════════════════════════════
# DeepSight — variables du site web, injectées au moment du build Vite
#
# bootstrap.sh copie ce fichier vers /opt/deepsight/repo/.env.frontend.
# Ces valeurs finissent dans le JavaScript public du site : n'y mets jamais
# de clé secrète, uniquement des identifiants publics.
# ═══════════════════════════════════════════════════════════════════════════════

VITE_API_URL=https://api.deepsightsynthesis.com

# Analytics PostHog (UE), chargé seulement après consentement
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Suivi d'erreurs (optionnel)
VITE_SENTRY_DSN=

# Connexion Google (identifiant client public)
VITE_GOOGLE_CLIENT_ID=
