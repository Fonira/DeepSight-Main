# ═══════════════════════════════════════════════════════════════════════════════
# DeepSight — variables du backend en production (VPS)
#
# bootstrap.sh copie ce fichier vers /opt/deepsight/repo/.env.production
# (droits 600, jamais commité) et remplace chaque __GENERATE__ par un secret
# aléatoire. Il te reste à coller tes clés d'API dans les lignes vides.
#
# Éditer sur le serveur : nano /opt/deepsight/repo/.env.production
# Puis appliquer :        /opt/deepsight/repo/deploy/vps/scripts/deploy.sh
#
# Pas de guillemets autour des valeurs, pas d'espace autour du "=".
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Base ─────────────────────────────────────────────────────────────────────
ENV=production
FRONTEND_URL=https://www.deepsightsynthesis.com
APP_URL=https://api.deepsightsynthesis.com
API_PUBLIC_URL=https://api.deepsightsynthesis.com
ALLOWED_ORIGINS=https://www.deepsightsynthesis.com,https://deepsightsynthesis.com

# ─── Mode privé ───────────────────────────────────────────────────────────────
# true  = seul l'admin peut se connecter (pour tester après le déploiement)
# false = DeepSight rouvert au public
PRIVATE_MODE=true

# ─── Admin ────────────────────────────────────────────────────────────────────
# Ton email de connexion à DeepSight (compte admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=__GENERATE__
ADMIN_SECRET_KEY=__GENERATE__
JWT_SECRET_KEY=__GENERATE__

# ─── Base de données et cache (utilisés par docker-compose) ───────────────────
POSTGRES_USER=deepsight
POSTGRES_DB=deepsight
POSTGRES_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__

# ─── Ressources ───────────────────────────────────────────────────────────────
# 2 workers pour 4 Go de RAM (VPS 500). Passer à 4 avec 8 Go (VPS 1000).
UVICORN_WORKERS=2

# ─── IA ───────────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=
# Transcriptions YouTube (méthode principale ; sans clé, repli sur les autres méthodes)
SUPADATA_API_KEY=
BRAVE_SEARCH_API_KEY=
PERPLEXITY_API_KEY=
ELEVENLABS_API_KEY=

# ─── Emails (vérification de compte, mot de passe oublié) ─────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@deepsightsynthesis.com

# ─── Connexion Google ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Paiements Stripe ─────────────────────────────────────────────────────────
# Laisser à false tant que le compte Stripe n'est pas récupéré et vérifié.
STRIPE_ENABLED=false
STRIPE_TEST_MODE=false
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY_LIVE=
STRIPE_PRICE_PRO_YEARLY_LIVE=
STRIPE_PRICE_EXPERT_MONTHLY_LIVE=
STRIPE_PRICE_EXPERT_YEARLY_LIVE=

# ─── Monitoring (optionnel) ───────────────────────────────────────────────────
SENTRY_DSN=
